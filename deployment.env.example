# Server-only variables. Never add NEXT_PUBLIC_ or commit real values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-vercel-environment-settings
SUPABASE_BUCKET=studio-private
# Supabase transaction pooler, with TLS verification.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full
# Exactly 64 lowercase hex characters. Generate with crypto.randomBytes(32).toString('hex').
ADMIN_ACCESS_TOKEN=replace-with-random-64-hex-secret
