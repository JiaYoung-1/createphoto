{
  "manifest_version": 3,
  "name": "俞总和小吴工作站 · 新站接单",
  "version": "2.0.1",
  "description": "在已登录的 Chrome 中接收私人工作室任务，通过 ChatGPT 网页生成并保存图片。",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://yzqwjy.cn/*",
    "https://www.yzqwjy.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开工作室接单台"
  },
  "content_scripts": [
    {
      "matches": [
        "https://yzqwjy.cn/*",
        "https://www.yzqwjy.cn/*"
      ],
      "js": [
        "shared.js",
        "studio.js"
      ]
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "shared.js",
        "gpt.js"
      ]
    }
  ]
}